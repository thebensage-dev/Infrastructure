# LOCAL ONLY: values for ../monitoring/compose.yaml when it runs in the local stack. Nothing here is
# a real secret: Grafana is only reachable on this machine and email is switched off in
# monitoring.override.yaml (the SMTP values only satisfy the required variables).
GRAFANA_URL=http://grafana.localhost:8080
SERVICE_PASSWORD_GRAFANAADMIN=admin

# The sites as seen from inside the stack's network (service names, plain HTTP).
MONITORED_SITES=http://portfolio:3000,http://user-directory:3000,http://storybook,http://api:8080/health,http://authentik-server:9000/-/health/ready/

# Sign-in through the local authentik. Its blueprint creates the "grafana" client with this same
# placeholder secret (identity.env), so there is nothing to copy.
GRAFANA_OAUTH_ENABLED=true
AUTHENTIK_URL=http://id.localhost:8080
GRAFANA_OIDC_CLIENT_SECRET=local-only-not-a-secret-grafana-oidc

# The local "Live status" link: http://grafana.localhost:8080/public-dashboards/<this>. The
# Portfolio footer in compose.yaml uses the same value.
STATUS_ACCESS_TOKEN=10ca1000000000000000000000000000

ALERT_EMAIL_FROM=grafana@example.com
ALERT_EMAIL_TO=admin@example.com
SMTP_HOST=localhost
SMTP_USERNAME=unused
SMTP_PASSWORD=unused

# Keep local history small.
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=1GB

# Keep local logs short.
LOKI_RETENTION=3d
