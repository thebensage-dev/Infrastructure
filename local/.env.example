# Copy to .env in this folder (gitignored). Compose reads it automatically.

# Required: classic GitHub token with only the read:packages scope, for @thebensage-dev/ui.
# Compose hands it to `npm ci` as a BuildKit secret, so it never lands in an image layer.
# (A NODE_AUTH_TOKEN already set in your shell wins over this line.)
NODE_AUTH_TOKEN=

# Required: password for authentik's admin user `akadmin` (http://id.localhost:8080). Only read
# the first time authentik starts with an empty database; change it in authentik after that.
# (Named like the variable Coolify generates for it in production.)
SERVICE_PASSWORD_AKADMIN=

# Optional: real email locally (access-request emails from authentik, alert emails from
# Grafana), through your own SMTP account. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME and
# ALERT_EMAIL_FROM = your Gmail address, SMTP_PASSWORD = an app password
# (https://myaccount.google.com/apppasswords), not your normal password. ALERT_EMAIL_TO gets new
# access requests and alerts. Then run `docker compose up -d` again.
# SMTP_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=

# Optional: another host port if 8080 is taken.
# PROXY_PORT=8080

