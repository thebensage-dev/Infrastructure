# Local reverse proxy for local/compose.yaml. Routes by host name; the port is ignored.
{
	admin off
	auto_https off
}

:80 {
	@users host users.localhost
	handle @users {
		reverse_proxy user-directory:3000
	}

	@ui host ui.localhost
	handle @ui {
		reverse_proxy storybook:80
	}

	@api host api.localhost
	handle @api {
		reverse_proxy api:8080
	}

	@id host id.localhost
	handle @id {
		reverse_proxy authentik-server:9000
	}

	@grafana host grafana.localhost
	handle @grafana {
		reverse_proxy grafana:3000
	}

	@prometheus host prometheus.localhost
	handle @prometheus {
		reverse_proxy prometheus:9090
	}

	handle {
		reverse_proxy portfolio:3000
	}
}
