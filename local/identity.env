# LOCAL ONLY: values for ../identity/compose.yaml when it runs in the local stack. Nothing here is a
# real secret: authentik is only reachable on this machine. Production sets its own in Coolify.
# The SERVICE_PASSWORD_* names match the variables Coolify generates in production. The admin
# password (SERVICE_PASSWORD_AKADMIN) is the one exception: it goes in the gitignored .env next
# to this file (see .env.example).
SERVICE_PASSWORD_64_AUTHENTIKSECRET=local-only-not-a-secret-authentik-secret-key-0123456789
SERVICE_PASSWORD_64_AUTHENTIKDB=local-only-not-a-secret-authentik-db
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com

GRAFANA_URL=http://grafana.localhost:8080
USER_DIRECTORY_URL=http://users.localhost:8080
API_URL=http://api.localhost:8080
MAIN_SITE_URL=http://localhost:8080
CMS_URL=http://cms.localhost:8080

# Must match GRAFANA_OIDC_CLIENT_SECRET in monitoring.env and the User Directory's secret in
# compose.yaml (and Portfolio's and the CMS's there), so local sign-in works with no copy-paste.
GRAFANA_OIDC_CLIENT_SECRET=local-only-not-a-secret-grafana-oidc
USER_DIRECTORY_OIDC_CLIENT_SECRET=local-only-not-a-secret-user-directory-oidc
PORTFOLIO_OIDC_CLIENT_SECRET=local-only-not-a-secret-portfolio-oidc
CMS_OIDC_CLIENT_SECRET=local-only-not-a-secret-cms-oidc
