# Environment of the identity app in Coolify. Don't type these in: the deploy job in
# .github/workflows/ci.yml writes them, derived from a few GitHub secrets and variables (see the README, "Deploying").

# Generated by Coolify on the first deploy (not in this list): SERVICE_PASSWORD_64_AUTHENTIKSECRET,
# SERVICE_PASSWORD_64_AUTHENTIKDB and SERVICE_PASSWORD_AKADMIN. The last is the password of the
# admin user `akadmin`: copy it from the app's Environment Variables page into your password
# manager, then sign in.

GRAFANA_URL=https://grafana.example.com
USER_DIRECTORY_URL=https://users.example.com
API_URL=https://api.example.com
MAIN_SITE_URL=https://example.com
CMS_URL=https://cms.example.com
GRAFANA_OIDC_CLIENT_SECRET=
USER_DIRECTORY_OIDC_CLIENT_SECRET=
PORTFOLIO_OIDC_CLIENT_SECRET=
CMS_OIDC_CLIENT_SECRET=
# Optional email for access requests (the same SMTP account and values as monitoring's alerts).
# New requests go to ALERT_EMAIL_TO (several: separate with ;). Leave SMTP_HOST empty for none.
SMTP_HOST=
SMTP_PORT=587
# true = STARTTLS (port 587, e.g. SMTP2GO)
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Optional: the admin's email (only read on the first start) and the sign-in page's title.
AUTHENTIK_BOOTSTRAP_EMAIL=
# AUTHENTIK_BRAND_TITLE=TheBensage   (the name on the sign-in pages: "Sign in to TheBensage")
