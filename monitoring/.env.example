# Environment of the monitoring app in Coolify. Don't type these in: the deploy job in
# .github/workflows/ci.yml writes them, derived from a few GitHub secrets and variables (see the README, "Deploying").
# Coolify generates SERVICE_PASSWORD_GRAFANAADMIN (the break-glass "admin" password) on the first
# deploy; copy it from the Environment Variables page into your password manager.

# Grafana's public URL (no trailing slash)
GRAFANA_URL=https://grafana.example.com
# Set to true once authentik sign-in works
GRAFANA_DISABLE_LOGIN_FORM=false
# Makes "Live status" public at $GRAFANA_URL/public-dashboards/<token> on every start (empty: not
# shared). 32 lowercase hex characters; the pipeline uses the first 32 of sha256("status:<DOMAIN>"),
# the same token Portfolio's pipeline puts in its STATUS_URL.
STATUS_ACCESS_TOKEN=

# Sites to check, comma-separated. In production the pipeline builds this from ../sites.yml.
MONITORED_SITES=https://example.com,https://users.example.com,https://api.example.com/health,https://ui.example.com,https://id.example.com/-/health/ready/

# authentik: its base URL, and the same GRAFANA_OIDC_CLIENT_SECRET as in the identity app (the
# pipeline derives both from PLATFORM_SECRET; the client itself is created by authentik's blueprint; its id is always "grafana")
GRAFANA_OAUTH_ENABLED=true
AUTHENTIK_URL=https://id.example.com
GRAFANA_OIDC_CLIENT_SECRET=

# Alert emails (any SMTP service; for Gmail use smtp.gmail.com, port 587 and an app password)
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional: how much metric history to keep (whichever limit is hit first)
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=5GB
# Optional: how long to keep container logs in Loki
LOKI_RETENTION=14d
